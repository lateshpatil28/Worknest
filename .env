# WorkNest Environment Configuration

# Database
POSTGRES_USER=worknest
POSTGRES_PASSWORD=worknest_secret
POSTGRES_DB=worknest_db
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://worknest:worknest_secret@db:5432/worknest_db
JWT_SECRET_KEY=worknest_production_jwt_super_secret_key_change_me_987654321
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
STORAGE_DIR=/app/storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,png,jpg,jpeg,gif,zip,csv,json
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://frontend

# Frontend
VITE_API_URL=/api/v1
PORT=3000
